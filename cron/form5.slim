  body
    .container
      h1 Анкета товара
      select class="form-control" id="select"
        option value="1" Обувь
        option value="2" Трикотаж
        option value="3" Верхняя одежда
        option value="4" Рубашки
        option value="5" selected="true" Пиджаки
      .row style="margin-bottom:30px;"
        form id="form" action="/rest_api/product_form" method="POST" enctype="multipart/form-data"
          .col-md-6

            .form-group
              label for="sku" Артикул
              input type="text" class="form-control" name="sku" id="sku"
            .form-group
              label for="sizes" Размеры
              input type="text" class="form-control" name="sizes" id="sizes"
            .form-group
              label for="brand_name" Брендовое имя (если есть)
              input type="text" class="form-control" name="brand_name" id="brand_name"
            .form-group
              label for="firm_tech" Фирменные характеристики, материалы и технологии
              input type="text" class="form-control" name="firm_tech" id="firm_tech"
            .form-group
              label for="contains" Состав
              input type="text" class="form-control" name="contains" id="contains"

            h3 Название модели
            .radio
              label
                input type="radio" name="model" value="Блейзер"
                | Блейзер
            .radio
              label
                input type="radio" name="model" value="Soft пиджак"
                | Soft пиджак
            .radio
              label
                input type="radio" name="model" value="Классический пиджак"
                | Классический пиджак
            .radio
              label
                input type="radio" name="model" value="Кожаный, Замшевый пиджак"
                | Кожаный, Замшевый пиджак
            .radio
              label
                input type="radio" name="model" value="Трикотажный пиджак"
                | Трикотажный пиджак
            .radio
              label
                input type="radio" name="model" value="Смокинг (вечерний пиджак)"
                | Смокинг (вечерний пиджак)

            h3 Модель пиджака
            .radio
              label
                input type="radio" name="jacket_type" value="Однобортный"
                | Однобортный
            .radio
              label
                input type="radio" name="jacket_type" value="Двубортный"
                | Двубортный

            h3 Количество пуговиц (для однобортного пиджака)
            .radio
              label
                input type="radio" name="jacket_buttons" value="1 пуговица"
                | 1 пуговица
            .radio
              label
                input type="radio" name="jacket_buttons" value="2 пуговицы"
                | 2 пуговицы
            .radio
              label
                input type="radio" name="jacket_buttons" value="3 пуговицы"
                | 3 пуговицы
            .radio
              label
                input type="radio" name="jacket_buttons" value="другое"
                | другое

            h3 Карманы
            .radio
              label
                input type="radio" name="pockets" value="Накладные"
                | Накладные
            .radio
              label
                input type="radio" name="pockets" value="Классические"
                | Классические
            .radio
              label
                input type="radio" name="pockets" value="3 кармана (Том Форд)"
                | 3 кармана (Том Форд)

            h3 Лацканы
            .radio
              label
                input type="radio" name="jacket_latzk" value="Пики"
                | Пики
            .radio
              label
                input type="radio" name="jacket_latzk" value="Классика"
                | Классика
            .radio
              label
                input type="radio" name="jacket_latzk" value="Закругленные"
                | Закругленные
            .radio
              label
                input type="radio" name="jacket_latzk" value="Шаль"
                | Шаль

            h3 Шлицы
            .radio
              label
                input type="radio" name="schlitz" value="Центральная шлица"
                | Центральная шлица
            .radio
              label
                input type="radio" name="schlitz" value="2 шлицы"
                | 2 шлицы
            .radio
              label
                input type="radio" name="schlitz" value="Без шлица"
                | Без шлица

            h3 Рост изделия
            .radio
              label
                input type="radio" name="length" value="Длинный (LONG)"
                | Длинный (LONG)
            .radio
              label
                input type="radio" name="length" value="Стандартный (REGULAR)"
                | Стандартный (REGULAR)
            .radio
              label
                input type="radio" name="length" value="Короткий (CORT)"
                | Короткий (CORT)

            h3 Объем изделия - Посадка
            .radio
              label
                input type="radio" name="fit" value="5 (очень свободное) Super Comfort Fit"
                | 5 (очень свободное) Super Comfort Fit
            .radio
              label
                input type="radio" name="fit" value="6 (свободное) Comfort Fit"
                | 6 (свободное) Comfort Fit
            .radio
              label
                input type="radio" name="fit" value="7 (в меру приталенный) Regular Fit"
                | 7 (в меру приталенный) Regular Fit
            .radio
              label
                input type="radio" name="fit" value="8 (приталенный) Slim Fit"
                | 8 (приталенный) Slim Fit
            .radio
              label
                input type="radio" name="fit" value="9 (очень приталенный) Super Slim Fit"
                | 9 (очень приталенный) Super Slim Fit

            h3 Подкладка
            .radio
              label
                input type="radio" name="inside" value="Без подкладки"
                | Без подкладки
            .radio
              label
                input type="radio" name="inside" value="Половина подкладки"
                | Половина подкладки
            .radio
              label
                input type="radio" name="inside" value="Полная подкладка"
                | Полная подкладка

          .col-md-6
            h3 Рукав
            .radio
              label
                input type="radio" name="sleeve" value="Законченный (с пуговицами)"
                | Законченный (с пуговицами)
            .radio
              label
                input type="radio" name="sleeve" value="Не законченный (без пуговиц)"
                | Не законченный (без пуговиц)
            .radio
              label
                input type="radio" name="sleeve" value="Молния"
                | Молния

            .h3 Цвет ткани
            .row
              .col-xs-6
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Черный (серый)" Черный (серый)
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Белый" Белый
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Коричневый (рыжий,бежевый)" Коричневый (рыжий,бежевый)
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Синий (голубой, бирюзовый)" Синий (голубой, бирюзовый)
              .col-xs-6
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Красный (бордовый)" Красный (бордовый)
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Зеленый" Зеленый
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Желтый" Желтый
                .checkbox
                  label
                    input type="checkbox" name="color[]" value="Яркие цвета (электрики, кислотные цвета и т.д.)" Яркие цвета (электрики, кислотные цвета и т.д.)

            .h3 Описание ткани (узор)
            .radio
              label
                input type="radio" name="pattern" value="Клетка"
                | Клетка
            .radio
              label
                input type="radio" name="pattern" value="Полоска"
                | Полоска
            .radio
              label
                input type="radio" name="pattern" value="Однотонный"
                | Однотонный
            .radio
              label
                input type="radio" name="pattern" value="Принт"
                | Принт

            .h3 Цвет подкладки
            .row
              .col-xs-6
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Черный (серый)" Черный (серый)
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Белый" Белый
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Коричневый (рыжий,бежевый)" Коричневый (рыжий,бежевый)
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Синий (голубой, бирюзовый)" Синий (голубой, бирюзовый)
              .col-xs-6
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Красный (бордовый)" Красный (бордовый)
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Зеленый" Зеленый
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Желтый" Желтый
                .checkbox
                  label
                    input type="checkbox" name="inside_color[]" value="Яркие цвета (электрики, кислотные цвета и т.д.)" Яркие цвета (электрики, кислотные цвета и т.д.)

            .h3 Мелтон – Задняя сторона воротника
            .radio
              label
                input type="radio" name="melton" value="Замша"
                | Замша
            .radio
              label
                input type="radio" name="melton" value="Кожа"
                | Кожа
            .radio
              label
                input type="radio" name="melton" value="Ткань"
                | Ткань
            .radio
              label
                input type="radio" name="melton" value="Экзотика"
                | Экзотика

            .h3 Мелтон цвет
            .row
              .col-xs-6
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Черный (серый)" Черный (серый)
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Белый" Белый
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Коричневый (рыжий,бежевый)" Коричневый (рыжий,бежевый)
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Синий (голубой, бирюзовый)" Синий (голубой, бирюзовый)
              .col-xs-6
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Красный (бордовый)" Красный (бордовый)
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Зеленый" Зеленый
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Желтый" Желтый
                .checkbox
                  label
                    input type="checkbox" name="melton_color[]" value="Яркие цвета (электрики, кислотные цвета и т.д.)" Яркие цвета (электрики, кислотные цвета и т.д.)

            h3 Налокотники
            .radio
              label
                input type="radio" name="elbows" value="Замша"
                | Замша
            .radio
              label
                input type="radio" name="elbows" value="Замша перфорация"
                | Замша перфорация
            .radio
              label
                input type="radio" name="elbows" value="Кожа"
                | Кожа
            .radio
              label
                input type="radio" name="elbows" value="Кожа перфорация"
                | Кожа перфорация
            .radio
              label
                input type="radio" name="elbows" value="Ткань"
                | Ткань
            .radio
              label
                input type="radio" name="elbows" value="Экзотика"
                | Экзотика

            .h3 Материал пуговиц
            .radio
              label
                input type="radio" name="buttons_material" value="Метал – Клубные"
                | Метал – Клубные
            .radio
              label
                input type="radio" name="buttons_material" value="Натуральный рог"
                | Натуральный рог
            .radio
              label
                input type="radio" name="buttons_material" value="Перламутр"
                | Перламутр
            .radio
              label
                input type="radio" name="buttons_material" value="Ракушка"
                | Ракушка

            .h3 Сезон
            .radio
              label
                input type="radio" name="season" id="season1" value="Лето" Лето
            .radio
              label
                input type="radio" name="season" id="season2" value="Весь год" Весь год
            .radio
              label
                input type="radio" name="season" id="season3" value="Зима" Зима

            h3 Комментарии
            .form-group
              textarea class="form-control" name="comments" id="comments" rows="4" autocomplete="off"

            .form-group
              label for="photo" Фотография товара
              input type="file" name="photo" id="photo" accept="image/*" capture="camera"

            button type="submit" id="submit" class="btn btn-primary" Отправить
            button type="button" id="reset" class="btn btn-default" style="margin-left:10px;" Очистить

