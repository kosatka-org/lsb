<div id="inserts_all">  <!-- Вкладки /-->  {include file='sections_menu.tpl' active='video'}  <!-- /Вкладки /--></div>	<!-- Content #Begin /--><div id="content">  <div id="cont_border">    <div id="cont">           <div id="cont_top">        <!-- Иконка раздела /-->         <img src="./images/icon_content.jpg" alt="" class="line"/>        <!-- /Иконка раздела /-->                <!-- Заголовок раздела /-->        <h1 id="headline">Видео</h1>        <!-- /Заголовок раздела /-->      </div>	        <div id="cont_center" style="margin-top:30px;">        <form autocomplete="off" action='index.php?section=Video&update_video' method="post">          {foreach from=$videos item=vid}          <div style="overflow:hidden; margin-bottom:20px;">            <div style="float:left; margin-right:20px;"><iframe width="400" height="auto" src="https://www.youtube.com/embed/{$vid->youtube_id}?rel=0" frameborder="0" gesture="media" allow="encrypted-media" allowfullscreen></iframe></div>            <input value='{$vid->video}' class="input3" style="width:400px;" name="video[]" type="text"/>          </div>          {/foreach}          <input type="submit" value="Сохранить" class="submit" style="float:none;"/>        </form>      </div>    </div>	</div></div>	 