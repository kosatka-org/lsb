<div id="inserts_all">  <!-- Вкладки /-->  {include file='Copywriter_menu.tpl' active='tasksM'}  <!-- /Вкладки /-->     <!-- Путь /-->  <table id="in_right">    <tr>      <td>        <p>          <a href="./">Luxury Store</a> →          задания копирайтеров</a>        </p>      </td>    </tr>  </table>  <!-- /Путь /-->  </div><!-- Content #Begin /--><div id="content">  <div id="cont_border">    <div id="cont">           <div id="cont_top">        <!-- Иконка раздела /--> 	    <img src="./images/icon_users.jpg" alt="" class="line"/>	    <!-- /Иконка раздела /-->	    	    <!-- Заголовок раздела /-->        <h1 id="headline">Задание</h1>        <!-- /Заголовок раздела /-->                      </div>      <div id="cont_center">	  		 <div class="clear">&nbsp;</div>	  			{if $Error}			<!-- Error #Begin /-->			<div id="error_minh">			  <div id="error">				<img src="./images/error.jpg" alt=""/><p>{$Error}</p>								  </div>			</div>			<!-- Error #End /-->			{/if}		<FORM METHOD=POST name="task">		<input type="hidden" name="id" value="{$task->id}" />					<div id="over">								<table>								<tr>									<td class="model">Тип документа</td>									<td class="m_t"><p>										<select name="doc_type" onChange="document.task.submit();" style="width:400px;">											<option value="0">---</option>											<option value="product" {if $task->doc_type == "product"}selected{/if}>Товар</option>											<option value="category" {if $task->doc_type == "category"}selected{/if}>Категория</option>											<option value="city" {if $task->doc_type == "city"}selected{/if}>Город</option>											<option value="special" {if $task->doc_type == "special"}selected{/if}>Подборка</option>											<option value="brand" {if $task->doc_type == "brand"}selected{/if}>Бренд</option>											<option value="brand-category" {if $task->doc_type == "brand-category"}selected{/if}>Бренд-категория</option>										</select>									</p></td>								</tr>								{if $docs}								<tr>									<td class="model">Документ</td>									<td class="m_t"><p>										<select name="doc_id" style="width:400px;">											{foreach item=row from=$docs}												<option value="{$row->id}" {if $row->id == $task->doc_id}selected{/if}>{$row->name}; id: {$row->id}</option>											{/foreach}										</select>									</p></td>								</tr>								{/if}								{if $fields}								<tr>									<td class="model">Поле</td>									<td class="m_t"><p>										<select name="field" style="width:400px;">											{foreach item=field_name key=field from=$fields}												<option value="{$field}" {if $field == $task->field}selected{/if}>{$field_name}</option>											{/foreach}										</select>									</p></td>								</tr>								{/if}								<tr>									<td class="model">Комментарий(поле)</td>									<td class="m_t"><p><input name="task_comment" type="text" class="input3" style="width:400px;" value='{$task->task_comment}' /></p></td>								</tr>								<tr>									<td class="model">Копирайтер</td>									<td class="m_t"><p>										<select name="copywriter_id" style="width:400px;">											<option value="0">Не выбран</option>											{foreach item=row from=$copywriters}												<option value="{$row->user_id}" {if $row->user_id == $task->copywriter_id}selected{/if}>{$row->name}</option>											{/foreach}										</select>									</p></td>								</tr>								<tr>									<td class="model">Приоритет</td>									<td class="m_t"><p><input name="priority" type="text" class="input3" style="width:400px;" value='{$task->priority}' /></p></td>								</tr>							</table>													<p><input type="submit" value="Отправить" class="submit3" name="button" /></p>							</div>			</form>	  </div>	 </div>	</div></div>