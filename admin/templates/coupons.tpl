<div id="inserts_all">  <!-- Вкладки /-->  {include file='users_menu.tpl' active='coupons'}  <!-- /Вкладки /-->     <!-- Путь /-->  <table id="in_right">    <tr>      <td>        <p>          <a href="./">Simpla</a> →          Купоны</a>        </p>      </td>    </tr>  </table>  <!-- /Путь /-->  </div><!-- Content #Begin /--><div id="content">  <div id="cont_border">    <div id="cont">           <div id="cont_top">        <!-- Иконка раздела /--> 	    <img src="./images/icon_users.jpg" alt="" class="line"/>	    <!-- /Иконка раздела /-->	    	    <!-- Заголовок раздела /-->        <h1 id="headline">Купоны</h1>        <!-- /Заголовок раздела /-->				<div class="help2">            <a href="index.php?section=Coupon&token={$Token}" class="fl"><img src="./images/add.jpg" alt="" class="fl"/>Добавить купон</a>        </div>                      </div>	  	  <div id="cont_left">          <ul>			<li {if $filter_status_tpl == "0"}class="li_on"{/if} style='padding-left:15px;'><a href="?section=Coupons">Все</a></li>			<li {if $filter_status_tpl == "active"}class="li_on"{/if} style='padding-left:15px;'><a href="?section=Coupons&status=active">Активные</a></li>			<li {if $filter_status_tpl == "noactive"}class="li_on"{/if} style='padding-left:15px;'><a href="?section=Coupons&status=noactive">Не активные</a></li>		</ul>                  </div>        <!-- /Левое меню /-->      <div id="cont_right" style="margin-top:30px;">	  		 {if $coupons}			            <table id="list" style="width:600px;">              {foreach item=coupon from=$coupons}			  <tbody {if !$coupon->active}class="tovar_min"{/if}>			  <tr><td colspan="5"><a href="index.php?section=OrdersSearch&view=search&keyword=promo:{$coupon->code}">{if empty($coupon->text)}Описания нет{else}{$coupon->text|nl2br}{/if}</a><hr /></td></tr>			  <tr>					<th>Код</th>					<th style="text-align:center;">Карта</th>					<th style="text-align:center;">Начало - Конец</th>					<th style="text-align:center;">Скидка</th>					<th style="text-align:center;">Использований</th>					<th style="text-align:center;">&nbsp;</th>				</tr>              <tr>				<td valign="top">                  {$coupon->code}                </td>				<td valign="top" style="padding:0 15px; text-align:center;">                  {$coupon->card_number}                </td>                <td valign="top" style="padding:0 15px; text-align:center;">                  {$coupon->date_start} - {$coupon->date_finish}                </td>				<td valign="top" style="padding:0 15px; text-align:center;">                  {$coupon->value}{if $coupon->type == 'absolute'}руб.{else}%{/if}                </td>				<td valign="top" style="padding:0 15px; text-align:center;">                  {$coupon->num_uses}                </td>				<td valign="top" width="40px">					{if $coupon->delete_get}<a href="{$coupon->delete_get}" class="fl" onclick='if(!confirm("Подтвердите удаление")) return false;'><img src="./images/delete.jpg" title="Удалить"/></a>{else}&nbsp;{/if}                </td>              </tr>			  </tbody>              {/foreach}            </table>		 {/if}	   {$PagesNavigation}	  </div>		 </div>	</div></div>	 